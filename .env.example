# Salin file ini menjadi .env lalu isi nilainya
DATABASE_URL="file:./dev.db"
# Isi dengan teks acak minimal 32 karakter (contoh: jalankan `openssl rand -base64 32`)
AUTH_SECRET="ganti-dengan-teks-acak-minimal-32-karakter"
# Akun admin pertama, dibuat oleh `npm run setup`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-ini"
